APP_NAME=Predict Corridor API
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api
LOG_LEVEL=INFO

# PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/predict_corridor

# MQTT (HiveMQ or compatible). Disabled by default so the API boots without a broker.
MQTT_ENABLED=false
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=predict-corridor-api
MQTT_TOPIC_PREFIX=corridor

# Enabled utility plugins (comma-separated kinds)
ENABLED_UTILITIES=water
