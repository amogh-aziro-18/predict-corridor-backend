APP_NAME=Predict Corridor API
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api
LOG_LEVEL=INFO

# PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/predict_corridor

# MQTT (HiveMQ or compatible). Disabled by default so the API boots without a broker.
MQTT_ENABLED=false
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=predict-corridor-api
MQTT_TOPIC_PREFIX=corridor

# Enabled utility plugins (comma-separated kinds).
# Water, Power, and Gas plugins are available; include kinds to register at API startup.
# Seed always upserts Water + Power + Gas foundation records regardless of this list.
# Environments with only water,power continue to work for plugin registration.
# Example: ENABLED_UTILITIES=water,power,gas,communications
ENABLED_UTILITIES=water,power,gas,communications

# External weather (Phase 8A — Open-Meteo keyless POC)
WEATHER_PROVIDER=open_meteo
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_CACHE_TTL_SECONDS=600
WEATHER_FORECAST_CACHE_TTL_SECONDS=1800
WEATHER_HTTP_TIMEOUT_SECONDS=15

# Operational corridor location (Phase 14.12 — Delhi, India)
# Weather + environment providers query these coordinates (not Bangalore).
CORRIDOR_CITY=Delhi
CORRIDOR_COUNTRY=India
CORRIDOR_DISPLAY_NAME=Delhi, India
CORRIDOR_LATITUDE=28.6139
CORRIDOR_LONGITUDE=77.2090
CORRIDOR_TIMEZONE_HINT=Asia/Kolkata

# External air quality (Phase 9B — Open-Meteo Air Quality API, keyless POC)
# Provider supplies US AQI — never presented as CPCB / Indian National AQI.
ENVIRONMENT_PROVIDER=open_meteo_air_quality
OPEN_METEO_AIR_QUALITY_BASE_URL=https://air-quality-api.open-meteo.com/v1/air-quality
ENVIRONMENT_CACHE_TTL_SECONDS=600
ENVIRONMENT_HTTP_TIMEOUT_SECONDS=15
